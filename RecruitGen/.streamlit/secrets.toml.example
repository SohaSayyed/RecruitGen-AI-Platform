# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud "Secrets" box.
[ai]
api_key = "YOUR_API_KEY"
api_key_backup = "OPTIONAL_SECOND_API_KEY"   # used automatically if the first key fails
base_url = "https://YOUR_PROVIDER/v1"
model = "YOUR_TEXT_MODEL"
vision_model = "YOUR_VISION_MODEL"
